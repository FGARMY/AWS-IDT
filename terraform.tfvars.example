################################################################################
# Example Variables — Copy to terraform.tfvars and customize
# cp terraform.tfvars.example terraform.tfvars
################################################################################

# --- General ---
aws_region   = "us-east-1"
project_name = "aws-idt"
environment  = "dev"
owner        = "your-name"

# --- Networking ---
vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.10.0/24", "10.0.20.0/24"]
enable_vpc_flow_logs = true

# --- Compute ---
instance_type              = "t3.micro"
ami_id                     = "" # Leave empty for latest Amazon Linux 2023
asg_desired                = 2
asg_min                    = 1
asg_max                    = 4
root_volume_size           = 20
enable_detailed_monitoring = false

# --- Security ---
enable_ssh  = false
ssh_cidr    = "YOUR_IP/32" # Replace with your IP if enabling SSH
enable_ssm  = true
enable_https = false

# --- ALB ---
enable_alb_access_logs     = false
alb_logs_retention_days    = 90
enable_deletion_protection = false
health_check_path          = "/health"

# --- Monitoring ---
enable_cloudwatch_alarms = true
cpu_high_threshold       = 70
cpu_low_threshold        = 20
